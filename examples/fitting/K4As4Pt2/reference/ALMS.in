&general
 PREFIX = As2K2Pt_ncl
 MODE = optimize
 NAT = 120
 NKD = 3; KD = K As Pt
 TOLERANCE = 1.0e-5
 FC3_SHENGBTE=1
 FC4_SHENGBTE=1
/

&interaction
 NORDER = 3
 NBODY  = 2 3 3
 # Notes for higher-order runs when you later prepare optimize input:
 #   NORDER = 1 means 2nd-order force constants.
 #   NORDER = 2 means 3rd-order force constants.
 #   NORDER = 3 means 4th-order force constants.
 #   For 3rd order, NBODY must include 3-body terms: NBODY = 2 3
 #   For 4th order, a practical starting point is: NBODY = 2 3 3
 #   For 5th and higher order, extra high-order terms can often start from 2-body only.
/

&cutoff
 *-* None 12 8
 # Default second-order suggestion: keep harmonic cutoff as None.
 # When switching to optimize mode for higher-order FCs, increase cutoffs here.
 #   A good starting point for 3rd order is ~10 Bohr.
 #   For 4th order, try a smaller range such as 3rd-neighbor / 2nd-neighbor.
 #   For even higher order, start conservatively, e.g. 1st or 2nd neighbor.
 #   Also consider NBODY to limit interaction order; for high-order terms, 2-body
 #   truncation is often enough, while 3rd-order terms should keep 3-body terms.
/

&optimize
LMODEL = least-squares
DFSET = DFTSET_RAND

/

